    # Version control
    .git
    .gitignore

    # Local env files (never bake secrets into the image)
    .env
    backend/*/.env
    frontend/.env
    frontend/.env.local
    frontend/.env.*.local

    # Dev tooling / editor
    .husky
    .prettierrc.json
    eslint.config.mjs
    commitlint.config.cjs
    .npmrc.local

    # Test / docs
    **/*.test.ts
    **/*.spec.ts
    README.md
    Structured_Findings.md

    # OS artifacts
    .DS_Store
    Thumbs.db

    # Runtime logs — these grow to tens of GB locally and must never enter
    # the build context.
    logs
    **/logs
    *.log

    # Host build output. The builder stage compiles everything itself, so
    # shipping the host's copies only bloats the context and risks a stale
    # dist/ landing on top of a fresh build.
    **/dist
    frontend/.next
    outputs

    # Host node_modules. The deps stage runs `pnpm install` inside the image,
    # so /app/node_modules already exists before `COPY . .`. Sending the host
    # copy would overwrite those alpine/musl builds with glibc ones and add
    # ~1 GB to the context for nothing.
    node_modules
    **/node_modules
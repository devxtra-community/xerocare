{
  "devDependencies": {
    "@commitlint/cli": "^20.3.0",
    "@commitlint/config-conventional": "^20.3.0",
    "@eslint/js": "^9.39.2",
    "@types/amqplib": "^0.10.8",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jest-junit": "^17.0.0",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  },
  "scripts": {
    "build": "pnpm --filter employee_service run build && pnpm --filter api_gateway run build && pnpm --filter billing_service run build && pnpm --filter crm_service run build && pnpm --filter ven_inv_service run build && pnpm --filter frontend run build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "jest --config jest.config.ts --forceExit",
    "test:watch": "jest --config jest.config.ts --watch",
    "test:coverage": "jest --config jest.config.ts --coverage --forceExit",
    "test:accounting": "jest --config jest.config.ts --testPathPatterns=payments --forceExit",
    "test:ci": "jest --config jest.config.ts --ci --coverage --forceExit"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter frontend exec eslint --fix",
      "pnpm exec prettier --write"
    ],
    "backend/**/*.{ts,tsx,js,jsx}": [
      "pnpm exec eslint --fix",
      "pnpm exec prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "pnpm exec prettier --write"
    ]
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/pdfkit": "^0.17.5",
    "amqplib": "^0.10.9",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28",
    "winston": "^3.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "bcrypt",
      "sharp",
      "unrs-resolver",
      "core-js"
    ]
  }
}
